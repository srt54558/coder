# Pyodide's interactive stdin bridge uses SharedArrayBuffer in its worker.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Documents that select the installed version must revalidate.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Vite content hashes make these safe to keep.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# The directory name is the Pyodide version, so a new runtime is a new URL.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
